# Local memory API development settings.
# The coding-agent installer manages its own loopback daemon and profile; see
# remember-integrations/coding-agents/README.md for that workflow.

REMEMBER_API_HOST=127.0.0.1
REMEMBER_API_PORT=8888

# Supported providers: openai, openai-responses, openai-codex, chatgpt, anthropic,
# claude-code, ollama, lmstudio, llamacpp. Use a model supported by the provider.
REMEMBER_API_LLM_PROVIDER=openai
REMEMBER_API_LLM_API_KEY=your-api-key-here
REMEMBER_API_LLM_MODEL=gpt-4o-mini
# REMEMBER_API_LLM_BASE_URL=https://api.openai.com/v1
# Example: Anthropic Claude configuration
# REMEMBER_API_LLM_PROVIDER=anthropic
# REMEMBER_API_LLM_API_KEY=your-anthropic-api-key
# REMEMBER_API_LLM_MODEL=claude-haiku-4-5
# Local Ollama example:
# REMEMBER_API_LLM_PROVIDER=ollama
# REMEMBER_API_LLM_MODEL=llama3.2
# REMEMBER_API_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Memory storage defaults to local embedded PostgreSQL in the daemon profile.
# REMEMBER_API_DATABASE_URL=pg0://remember

# Embeddings: local, onnx, tei, openai, or openai-codex.
# REMEMBER_API_EMBEDDINGS_PROVIDER=local
# REMEMBER_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
# REMEMBER_API_EMBEDDINGS_LOCAL_FORCE_CPU=false
# REMEMBER_API_EMBEDDINGS_TEI_URL=http://127.0.0.1:8080
# REMEMBER_API_EMBEDDINGS_OPENAI_API_KEY=your-openai-api-key

# Reranking: local, onnx, tei, flashrank, jina-mlx, or rrf.
# REMEMBER_API_RERANKER_PROVIDER=local
# REMEMBER_API_RERANKER_LOCAL_FORCE_CPU=false
# REMEMBER_API_RERANKER_TEI_URL=http://127.0.0.1:8081

# Local diagnostics. Tracing stays in-process; metrics are exposed locally.
# REMEMBER_API_OTEL_TRACES_ENABLED=false
# REMEMBER_API_METRICS_BACKLOG_ENABLED=false
# REMEMBER_API_LLM_TRACE_ENABLED=false
