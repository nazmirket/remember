# Local memory API development settings.
# The coding-agent installer manages its own loopback daemon and profile; see
# hindsight-integrations/coding-agents/README.md for that workflow.

HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888

# Supported providers: openai, openai-responses, openai-codex, chatgpt, anthropic,
# claude-code, ollama, lmstudio, llamacpp. Use a model supported by the provider.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=your-api-key-here
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1
# Example: Anthropic Claude configuration
# HINDSIGHT_API_LLM_PROVIDER=anthropic
# HINDSIGHT_API_LLM_API_KEY=your-anthropic-api-key
# HINDSIGHT_API_LLM_MODEL=claude-haiku-4-5
# Local Ollama example:
# HINDSIGHT_API_LLM_PROVIDER=ollama
# HINDSIGHT_API_LLM_MODEL=llama3.2
# HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Memory storage defaults to local embedded PostgreSQL in the daemon profile.
# HINDSIGHT_API_DATABASE_URL=pg0://hindsight

# Embeddings: local, onnx, tei, openai, or openai-codex.
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
# HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
# HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=false
# HINDSIGHT_API_EMBEDDINGS_TEI_URL=http://127.0.0.1:8080
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=your-openai-api-key

# Reranking: local, onnx, tei, flashrank, jina-mlx, or rrf.
# HINDSIGHT_API_RERANKER_PROVIDER=local
# HINDSIGHT_API_RERANKER_LOCAL_FORCE_CPU=false
# HINDSIGHT_API_RERANKER_TEI_URL=http://127.0.0.1:8081

# Local diagnostics. Tracing stays in-process; metrics are exposed locally.
# HINDSIGHT_API_OTEL_TRACES_ENABLED=false
# HINDSIGHT_API_METRICS_BACKLOG_ENABLED=false
# HINDSIGHT_API_LLM_TRACE_ENABLED=false
