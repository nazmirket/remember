{
  "name": "remember-coding-agents",
  "version": "0.8.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazmirket/remember.git",
    "directory": "remember-integrations/coding-agents"
  },
  "description": "Local project memory for Codex and Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "remember-coding-agents": "dist/installer.js",
    "remember-claude-hook": "dist/claude-hook.js",
    "remember-codex-hook": "dist/codex-hook.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "skill",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "skill:build": "node scripts/build-skill.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run skill:build && npm run build",
    "test": "vitest run --exclude '**/*.e2e.test.ts'"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.0",
    "smol-toml": "^1.8.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "undici": "^6.29.1",
    "vitest": "^4.1.12",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": ">=2.1.3 <3.0.0",
    "esbuild": ">=0.25.0 <1.0.0",
    "fast-uri": ">=3.1.9 <4.0.0",
    "hono": ">=4.13.11 <5.0.0",
    "ip-address": ">=10.5.1 <11.0.0",
    "postcss": ">=8.5.23 <9.0.0",
    "toml": ">=5.0.1 <6.0.0",
    "vite": ">=6.4.3 <7.0.0"
  },
  "license": "MIT"
}
